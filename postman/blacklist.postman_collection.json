          "body": "{\n  \"msg\": \"El email cliente.spam@example.com fue agregado a la lista negra global\",\n  \"blacklist\": {\n    \"id\": \"c1a3e2a0-8f7d-4f8e-9a8e-2b6a1d2f7c11\",\n    \"email\": \"cliente.spam@example.com\",\n    \"app_uuid\": \"3f0f0b4e-6b1a-4c9e-9a51-2f1d7c8a9b10\",\n    \"blocked_reason\": \"Envio masivo de spam\",\n    \"request_ip\": \"181.50.10.20\",\n    \"created_at\": \"2026-10-17T21:30:00.123456+00:00\"\n  }\n}"
