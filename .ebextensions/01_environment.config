option_settings:
  # Aplicacion WSGI (application.py -> objeto "application")
  aws:elasticbeanstalk:container:python:
    WSGIPath: application:application

  # Ambiente con Application Load Balancer (solo aplica al crear el ambiente)
  aws:elasticbeanstalk:environment:
    EnvironmentType: LoadBalanced
    LoadBalancerType: application

  # Auto Scaling: minimo 3, maximo 6 instancias
  aws:autoscaling:asg:
    MinSize: 3
    MaxSize: 6

  # Health checks: el balanceador consulta /health (no requiere token)
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    HealthCheckInterval: 15
    HealthCheckTimeout: 5
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
    MatcherHTTPCode: 200

  # Reporte de salud mejorado
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
